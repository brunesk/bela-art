rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bela Art — exatamente como estava, sem nenhuma mudanca
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && userId == 'bela-art'
        && request.auth.token.email in ['brunoferrack@gmail.com', 'contatojoco@gmail.com'];
    }

    // Meta 100K — painel pessoal, sem login
    match /publico/meta100k-7f3a9c2b41d6 {
      allow read, write: if true;
    }
  }
}
